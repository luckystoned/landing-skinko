---
import EditorialHeading from "@/components/ui/EditorialHeading.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import type { ContentStatus, JourneyPhase } from "@/schemas/skinko";
interface Props { status: ContentStatus; phases: JourneyPhase[] }
const { status, phases } = Astro.props;
---
<section id="journey" class="journey" aria-labelledby="journey-title" data-status={status}>
  <header><SectionLabel index="06" label="The journey" /><StatusBadge {status} label="Proceso propuesto" /></header>
  <EditorialHeading id="journey-title" level="h2" size="display-lg">From a real place to a real artwork.</EditorialHeading>
  <ol>{phases.map((phase) => <li><span>{String(phase.phase).padStart(2,"0")}</span><h3>{phase.label}</h3><p>{phase.description}</p></li>)}</ol>
  <aside><strong>Optional · Proposed</strong><p>También se podría explorar la participación de una institución cultural como partner de una instancia de jurado o desarrollo.</p></aside>
</section>
<style>
  .journey{padding-inline:var(--space-gutter)}header{display:flex;justify-content:space-between;gap:1rem}.journey :global(.editorial-heading){max-width:13ch;margin:clamp(3rem,8vw,7rem) 0}
  ol{list-style:none;margin:0;padding:0;border-block-start:1px solid var(--color-fg-primary)}li{display:grid;grid-template-columns:2.5rem 1fr;gap:.5rem 1rem;padding:1.5rem 0;border-block-end:1px solid var(--color-border)}li span,aside strong{font:600 var(--text-eyebrow)/1.3 var(--font-utility);letter-spacing:.09em;text-transform:uppercase}h3,p{margin:0}li p{grid-column:2;max-width:36rem;color:var(--color-fg-muted)}aside{display:grid;gap:1rem;max-width:42rem;margin:4rem 0 0 auto;padding:1.5rem;border-inline-start:2px solid var(--color-accent)}
  @media(min-width:48rem){li{grid-template-columns:3rem 1fr 1.5fr;align-items:baseline}li p{grid-column:3}}
</style>
