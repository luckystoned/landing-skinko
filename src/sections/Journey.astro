---
import EditorialHeading from "@/components/ui/EditorialHeading.astro";
import PhaseLabel from "@/components/ui/PhaseLabel.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import type { ContentStatus, JourneyPhase } from "@/schemas/skinko";

interface Props {
  status: ContentStatus;
  phases: JourneyPhase[];
}

const { status, phases } = Astro.props;
---

<section
  id="journey"
  class="journey"
  aria-labelledby="journey-title"
  data-status={status}
>
  <div class="journey__stage">
    <header class="journey__header">
      <SectionLabel index="06" label="The Journey" />
      <EditorialHeading id="journey-title" level="h2" size="display-lg">
        From call{" "}<br />to activation.
      </EditorialHeading>
      <div class="journey__context">
        <span>Proposed process · 01—07</span>
        <p>
          Siete fases posibles para llevar una idea desde la convocatoria hasta su materialización.
        </p>
      </div>
    </header>

    <ol class="journey__rail">
      {phases.map((phase) => <li><PhaseLabel {...phase} /></li>)}
    </ol>
  </div>
</section>

<style>
  .journey {
    padding-inline: var(--space-gutter);
    background: var(--color-bg-primary);
  }

  .journey__header {
    display: grid;
    gap: 1.5rem;
    margin-block-end: clamp(4rem, 10vw, 8rem);
  }

  .journey__header :global(.editorial-heading) {
    max-width: 10ch;
    text-transform: uppercase;
  }

  .journey__context {
    display: grid;
    gap: 1rem;
  }

  .journey__context span {
    font-family: var(--font-utility);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }

  .journey__context p {
    max-width: 27rem;
    margin: 0;
  }

  .journey__rail {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .journey__header {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: 1rem;
    }

    .journey__header > :global(*) {
      grid-column: 1 / -1;
    }

    .journey__header :global(.editorial-heading) {
      grid-column: 1 / 6;
    }

    .journey__context {
      grid-column: 6 / -1;
      align-self: end;
    }

    .journey__rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
    }
  }

  @media (min-width: 64rem) {
    .journey__header {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.25rem;
    }

    .journey__header :global(.editorial-heading) {
      grid-column: 1 / 8;
    }

    .journey__context {
      grid-column: 9 / -1;
    }

    .journey__rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1.25rem;
    }
  }

  @media (min-width: 64rem) and (min-height: 42rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (width: 1cqw) {
      .journey {
        height: 300svh;
        padding: 0;
        view-timeline-name: --journey;
        view-timeline-axis: block;
      }

      .journey__stage {
        position: sticky;
        top: 0;
        display: grid;
        container-type: inline-size;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto 1fr;
        height: 100svh;
        overflow: hidden;
        padding: clamp(2rem, 5vh, 4rem) var(--space-gutter);
      }

      .journey__header {
        margin-block-end: clamp(2rem, 5vh, 4rem);
      }

      .journey__header :global(.editorial-heading) {
        font-size: clamp(4rem, 7vw, 7rem);
      }

      .journey__rail {
        align-self: end;
        grid-template-columns: repeat(7, clamp(18rem, 28cqw, 26rem));
        width: max-content;
        animation: journey-pan linear both;
        animation-timeline: --journey;
        animation-range: cover 25% cover 75%;
      }

      @keyframes journey-pan {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(calc(-100% + 100cqw));
        }
      }
    }
  }
</style>
