---
import EditorialHeading from "@/components/ui/EditorialHeading.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import type { ContentStatus, ProposedMilestone } from "@/schemas/skinko";
interface Props { status: ContentStatus; milestones: ProposedMilestone[] }
const { status, milestones } = Astro.props;
---

<section id="roadmap" class="roadmap" aria-labelledby="roadmap-title" data-status={status}>
  <header class="roadmap__header"><SectionLabel index="11" label="Proposed Roadmap" /><StatusBadge {status} label="Proposed timeline" /></header>
  <div class="roadmap__intro">
    <EditorialHeading id="roadmap-title" level="h2" size="display-lg">November 2026<br />— April 2027</EditorialHeading>
    <p>Un recorrido posible, concentrado en cinco momentos.</p>
  </div>
  <ol class="roadmap__timeline">
    {milestones.map((milestone, index) => (
      <li>
        <span class="roadmap__index">{String(index + 1).padStart(2, "0")}</span>
        <p class="roadmap__period">{milestone.period}</p>
        <h3>{milestone.focus}</h3>
        <p class="roadmap__description">{milestone.description}</p>
      </li>
    ))}
  </ol>
  <p class="roadmap__note">Timing sujeto a definición conjunta y aprobación de alcance.</p>
</section>

<style>
  .roadmap { padding-inline: var(--space-gutter); background: var(--color-bg-secondary); }
  .roadmap__header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-block-end: clamp(4rem, 10vw, 8rem); }
  .roadmap__header :global(.status-badge) { margin: 0; text-align: end; }
  .roadmap__intro { display: grid; gap: 2rem; }
  .roadmap__intro :global(.editorial-heading) { max-width: 10ch; text-transform: uppercase; }
  .roadmap__intro > p { max-width: 18rem; margin: 0; font: clamp(1.5rem, 3vw, 2.5rem)/1.05 var(--font-editorial); }
  .roadmap__timeline { margin: clamp(5rem, 12vw, 10rem) 0 0; padding: 0; border-block-start: 1px solid var(--color-fg-primary); list-style: none; }
  .roadmap__timeline li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 0.5rem 1rem; padding-block: 1.25rem 1.5rem; border-block-end: 1px solid var(--color-border); }
  .roadmap__index, .roadmap__period, .roadmap__note { font: 600 var(--text-eyebrow)/1.3 var(--font-utility); letter-spacing: 0.09em; text-transform: uppercase; }
  .roadmap__period, .roadmap__description { margin: 0; }
  .roadmap__period { color: var(--color-fg-muted); }
  .roadmap__timeline h3 { grid-column: 2; min-width: 0; margin: 0.4rem 0; font-size: clamp(2.5rem, 9vw, 7rem); line-height: 0.88; letter-spacing: -0.035em; text-transform: uppercase; overflow-wrap: anywhere; }
  .roadmap__description { grid-column: 2; max-width: 27rem; color: var(--color-fg-muted); }
  .roadmap__note { max-width: 28rem; margin: 3rem 0 0 auto; color: var(--color-fg-muted); text-align: end; }
  @media (min-width: 48rem) {
    .roadmap__intro { grid-template-columns: repeat(8, minmax(0, 1fr)); column-gap: 1rem; }
    .roadmap__intro :global(.editorial-heading) { grid-column: 1 / 7; }
    .roadmap__intro > p { grid-column: 6 / -1; }
    .roadmap__timeline li { grid-template-columns: 3rem minmax(9rem, 1fr) minmax(0, 2fr); column-gap: 1rem; align-items: baseline; }
    .roadmap__period { grid-column: 2; }
    .roadmap__timeline h3 { grid-column: 3; grid-row: 1 / 3; margin: 0; font-size: clamp(3.5rem, 7vw, 6.5rem); }
    .roadmap__description { grid-column: 2; grid-row: 2; }
  }
  @media (min-width: 64rem) {
    .roadmap__intro { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.25rem; }
    .roadmap__intro :global(.editorial-heading) { grid-column: 1 / 9; }
    .roadmap__intro > p { grid-column: 10 / -1; align-self: end; }
    .roadmap__timeline li { grid-template-columns: 4rem minmax(13rem, 1fr) minmax(0, 2fr) minmax(14rem, 1fr); column-gap: 1.25rem; min-height: 9rem; }
    .roadmap__timeline h3 { grid-column: 3; grid-row: 1; }
    .roadmap__description { grid-column: 4; grid-row: 1; align-self: center; }
  }
</style>
