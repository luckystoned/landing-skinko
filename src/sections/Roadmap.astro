---
import EditorialHeading from "@/components/ui/EditorialHeading.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import type { ContentStatus, ProposedMilestone } from "@/schemas/skinko";
interface Props { status: ContentStatus; milestones: ProposedMilestone[] }
const { status, milestones } = Astro.props;
---
<section id="roadmap" class="roadmap" aria-labelledby="roadmap-title" data-status={status}>
  <header><SectionLabel index="11" label="Roadmap" /><StatusBadge {status} label="Proposed timeline" /></header>
  <EditorialHeading id="roadmap-title" level="h2" size="display-lg">November 2026<br />— April 2027</EditorialHeading>
  <ol>{milestones.map((item,index) => <li><span>{String(index+1).padStart(2,"0")}</span><p>{item.period}</p><h3>{item.focus}</h3><p>{item.description}</p></li>)}</ol>
</section>
<style>
  .roadmap{padding-inline:var(--space-gutter)}header{display:flex;justify-content:space-between;gap:1rem}.roadmap :global(.editorial-heading){margin:clamp(3rem,8vw,7rem) 0}ol{list-style:none;margin:0;padding:0;border-block-start:1px solid var(--color-fg-primary)}li{display:grid;grid-template-columns:2.5rem 1fr;gap:.5rem 1rem;padding:1.5rem 0;border-block-end:1px solid var(--color-border)}li span,li>p:first-of-type{font:600 var(--text-eyebrow)/1.3 var(--font-utility);letter-spacing:.08em;text-transform:uppercase}h3,p{margin:0}li>p:last-child{grid-column:2;color:var(--color-fg-muted)}@media(min-width:48rem){li{grid-template-columns:3rem 1fr 1.5fr 1.5fr;align-items:baseline}li>p:last-child{grid-column:4}}
</style>
