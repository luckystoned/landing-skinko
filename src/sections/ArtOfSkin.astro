---
import EditorialHeading from "@/components/ui/EditorialHeading.astro";
import Figure from "@/components/ui/Figure.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import { skinkoImages } from "@/data/skinko/assets";
import type { ArtExperience } from "@/schemas/skinko";

interface Props {
  experiences: ArtExperience[];
  copy?: { label: string; heading: string; first: string; second: string; closing: string };
}

const { experiences, copy } = Astro.props;
const assets = [skinkoImages.livingSculptures, skinkoImages.becomeTheArtist, skinkoImages.masterpiece];
---

<section id="art-of-skin" class="art-of-skin" aria-labelledby="art-of-skin-title">
  <div class="art-of-skin__intro">
    <SectionLabel index="02" label={copy?.label ?? "A territory already opened"} />
    <EditorialHeading id="art-of-skin-title" level="h2" size="display-lg">
      {copy?.heading ?? "Beauty, staged as art."}
    </EditorialHeading>
    <div class="art-of-skin__copy">
      <p>
        {copy?.first ?? "Para la apertura de Galerías Pacífico, SKINKO concibió el local como una galería contemporánea de skincare."}
      </p>
      <p>
        {copy?.second ?? "Producto, cuerpo, arquitectura, música y participación formaron parte de un mismo recorrido:"} <em>THE ART OF SKIN.</em>
      </p>
    </div>
  </div>

  <div class="art-of-skin__figures">
    {
      experiences.map((experience, position) => (
        <div class:list={["art-of-skin__figure", `art-of-skin__figure--${position + 1}`]}>
          <Figure
            index={experience.index}
            title={experience.name}
            ratio={experience.ratio}
            caption={experience.description}
            asset={assets[position]}
          />
        </div>
      ))
    }
  </div>

  <p class="art-of-skin__closing">
    {copy?.closing ?? "SKINKO ya convirtió skincare, espacio y participación en una experiencia artística. Bandadas propone profundizar esa dirección."}
  </p>
</section>

<style>
  .art-of-skin {
    padding-inline: var(--space-gutter);
    background: var(--color-bg-secondary);
  }

  .art-of-skin__intro {
    display: grid;
    gap: 2rem;
  }

  .art-of-skin__intro :global(.editorial-heading) {
    max-width: 12ch;
  }

  .art-of-skin__copy {
    display: grid;
    gap: 1rem;
    max-width: 36rem;
  }

  .art-of-skin__copy p {
    margin: 0;
  }

  .art-of-skin__copy p:first-child {
    font-size: var(--text-body-lg);
  }

  .art-of-skin__figures {
    display: grid;
    gap: clamp(3rem, 10vw, 8rem);
    margin-block-start: clamp(4rem, 10vw, 9rem);
  }

  .art-of-skin__figure--2 {
    margin-inline-start: clamp(1.5rem, 12vw, 8rem);
  }

  .art-of-skin__closing {
    max-width: 27ch;
    margin: clamp(5rem, 12vw, 10rem) 0 0 auto;
    font-family: var(--font-editorial);
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  @media (min-width: 48rem) {
    .art-of-skin__intro {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: 1rem;
    }

    .art-of-skin__intro :global(.section-label) {
      grid-column: 1 / -1;
    }

    .art-of-skin__intro :global(.editorial-heading) {
      grid-column: 1 / 7;
    }

    .art-of-skin__copy {
      grid-column: 5 / -1;
    }

    .art-of-skin__figures {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 1rem;
      align-items: start;
    }

    .art-of-skin__figure--1 {
      grid-column: 1 / 5;
    }

    .art-of-skin__figure--2 {
      grid-column: 5 / -1;
      margin: 9rem 0 0;
    }

    .art-of-skin__figure--3 {
      grid-column: 2 / 7;
      margin-block-start: 5rem;
    }
  }

  @media (min-width: 64rem) {
    .art-of-skin__intro,
    .art-of-skin__figures {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.25rem;
    }

    .art-of-skin__intro :global(.editorial-heading) {
      grid-column: 1 / 9;
    }

    .art-of-skin__copy {
      grid-column: 9 / -1;
      align-self: end;
    }

    .art-of-skin__figure--1 {
      grid-column: 1 / 5;
    }

    .art-of-skin__figure--2 {
      grid-column: 6 / 12;
    }

    .art-of-skin__figure--3 {
      grid-column: 3 / 8;
    }
  }
</style>
