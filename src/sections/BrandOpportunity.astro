---
import SectionLabel from "@/components/ui/SectionLabel.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import type { ChapterContent } from "@/schemas/chapter";
interface Props { content: ChapterContent["opportunity"] }
const { content } = Astro.props;
---
<section id="oportunidad" class="chapter-opportunity" aria-labelledby="opportunity-heading" data-status={content.status}>
  <SectionLabel index="01" label={content.label} />
  <div class="chapter-intro">
    <h2 id="opportunity-heading">{content.title}</h2>
    <div><p>{content.introduction}</p><p>{content.description}</p></div>
  </div>
  <StatusBadge status={content.status} label={content.statusLabel} />
  <dl class="chapter-benefits">
    {content.items.map((item, i) => <div><dt><span aria-hidden="true">0{i + 1}</span>{item.title}</dt><dd><p>{item.description}</p><p class="chapter-example">{item.example}</p></dd></div>)}
  </dl>
  <p class="chapter-pullquote">{content.closing}</p>
</section>
