---
import EditorialHeading from "@/components/ui/EditorialHeading.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import type { Benchmark } from "@/schemas/skinko";
interface Props { benchmarks: Benchmark[] }
const { benchmarks } = Astro.props;
---
<section id="benchmarks" class="benchmarks" aria-labelledby="benchmarks-title">
  <SectionLabel index="07" label="Documented references" />
  <EditorialHeading id="benchmarks-title" level="h2" size="display-lg">Site-specific is already a model.</EditorialHeading>
  <p class="intro">Cuatro casos muestran cómo distintas marcas conectaron convocatoria, espacio y obra. Los resultados cuantitativos se distinguen del valor estratégico observable.</p>
  <div class="cases">{benchmarks.map((item, index) => <article class:list={{featured:index < 2}}><header><span>{String(index+1).padStart(2,"0")}</span><p>{item.location}<br />{item.category}</p></header><h3>{item.name}</h3><dl><div><dt>What they did</dt><dd>{item.whatTheyDid}</dd></div><div><dt>Strategic value</dt><dd>{item.brandValue}</dd></div><div><dt>Why it matters for SKINKO</dt><dd>{item.relevance}</dd></div>{item.quantitativeResult && <div><dt>Documented data</dt><dd>{item.quantitativeResult}</dd></div>}</dl><a href={item.sourceUrl} target="_blank" rel="noreferrer">Fuente: {item.sourceLabel}<span class="sr-only"> (abre en una nueva pestaña)</span></a></article>)}</div>
  <p class="asset-note">Imágenes documentales pendientes de permiso. Esta versión utiliza composición editorial, sin recreaciones de IA.</p>
</section>
<style>
  .benchmarks{padding-inline:var(--space-gutter);background:var(--color-fg-primary);color:var(--color-on-dark)}.benchmarks :global(.section-label){color:#ffffffa8}.benchmarks :global(.editorial-heading){max-width:14ch;margin:clamp(3rem,8vw,7rem) 0 2rem}.intro{max-width:38rem;margin:0 0 clamp(4rem,10vw,8rem);color:#ffffffb8}.cases{display:grid;gap:1px;background:#ffffff40;border:1px solid #ffffff40}article{padding:clamp(1.25rem,3vw,2.5rem);background:var(--color-fg-primary)}article header{display:flex;justify-content:space-between;gap:1rem;font:600 var(--text-eyebrow)/1.4 var(--font-utility);letter-spacing:.08em;text-transform:uppercase;color:#ffffff9c}article header p{margin:0;text-align:end}h3{margin:3rem 0;font-size:clamp(2rem,4vw,4rem)}dl,dl div{display:grid;gap:.5rem}dl{gap:1.5rem}dt{font:600 var(--text-eyebrow)/1.3 var(--font-utility);letter-spacing:.08em;text-transform:uppercase;color:#ffffff8c}dd{margin:0;max-width:38rem}a{display:inline-block;margin-block-start:2rem;color:inherit;text-underline-offset:.3em}.asset-note{margin:2rem 0 0;font-size:var(--text-caption);color:#ffffff8c}
  @media(min-width:64rem){.cases{grid-template-columns:repeat(2,1fr)}article.featured{min-height:42rem}article:not(.featured){min-height:32rem}}
</style>
