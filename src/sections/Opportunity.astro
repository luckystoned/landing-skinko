---
import EditorialHeading from "@/components/ui/EditorialHeading.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import type { ContentStatus } from "@/schemas/skinko";
import type { Transformation } from "@/schemas/skinko";

interface Props {
  status: ContentStatus;
  transformations: Transformation[];
}

const { status, transformations } = Astro.props;
---

<section
  id="opportunity"
  class="opportunity"
  aria-labelledby="opportunity-title"
  data-status={status}
>
  <div class="opportunity__intro">
    <SectionLabel index="03" label="The Opportunity" inverse />
    <div class="opportunity__statement">
      <p>The Art of Skin</p>
      <p>as an activation</p>
    </div>
    <EditorialHeading id="opportunity-title" level="h2" size="display-lg">
      Ahora esa relación con el arte puede crecer.
    </EditorialHeading>
  </div>

  <ol class="opportunity__transformations">
    {
      transformations.map((transformation, index) => (
        <li>
          <span class="opportunity__index">0{index + 1}</span>
          <div>
            <span class="opportunity__from">{transformation.from}</span>
            <span class="opportunity__arrow" aria-hidden="true">→</span>
            <strong>{transformation.to}</strong>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="opportunity__resolution">
    <span>The Art of Skin</span>
    <strong>as a platform</strong>
    <p>Una idea de marca capaz de convertirse en un programa cultural.</p>
  </div>
</section>

<style>
  .opportunity {
    position: relative;
    padding-inline: var(--space-gutter);
    color: var(--color-on-dark);
    background: var(--color-fg-primary);
    border-block-end-color: color-mix(in srgb, var(--color-on-dark) 20%, transparent);
  }

  .opportunity__intro {
    display: grid;
    gap: 2rem;
  }

  .opportunity__statement {
    padding-block: 1rem;
    border-block: 1px solid color-mix(in srgb, var(--color-on-dark) 32%, transparent);
    font-family: var(--font-utility);
    font-size: var(--text-eyebrow);
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .opportunity__statement p {
    margin: 0;
  }

  .opportunity__statement p:last-child {
    color: color-mix(in srgb, var(--color-on-dark) 62%, transparent);
  }

  .opportunity__intro :global(.editorial-heading) {
    max-width: 15ch;
  }

  .opportunity__transformations {
    display: grid;
    min-width: 0;
    gap: 1rem;
    margin: clamp(4rem, 12vw, 10rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .opportunity__transformations li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    min-height: 16rem;
    padding-block: 1rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-on-dark) 24%, transparent);
  }

  .opportunity__transformations li > div {
    display: grid;
    min-width: 0;
    align-content: center;
    gap: 0.5rem;
  }

  .opportunity__index,
  .opportunity__from,
  .opportunity__arrow {
    font-family: var(--font-utility);
    font-size: var(--text-eyebrow);
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-on-dark) 58%, transparent);
  }

  .opportunity__transformations strong {
    display: block;
    max-width: 9ch;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .opportunity__resolution {
    display: grid;
    gap: 0.25rem;
    margin-block-start: clamp(4rem, 10vw, 8rem);
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--color-on-dark);
  }

  .opportunity__resolution span,
  .opportunity__resolution strong {
    font-family: var(--font-utility);
    font-size: var(--text-eyebrow);
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .opportunity__resolution p {
    max-width: 22ch;
    margin: 2rem 0 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    line-height: 1.05;
  }

  @media (min-width: 48rem) {
    .opportunity {
      display: grid;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: 1rem;
      align-items: start;
    }

    .opportunity__intro {
      position: sticky;
      top: clamp(2rem, 8vh, 6rem);
      grid-column: 1 / 5;
      max-height: calc(100svh - 4rem);
    }

    .opportunity__intro :global(.editorial-heading) {
      font-size: clamp(3rem, 6vw, 5.75rem);
    }

    .opportunity__transformations {
      grid-column: 5 / -1;
      margin-block-start: 8rem;
    }

    .opportunity__transformations li {
      min-height: 38svh;
    }

    .opportunity__resolution {
      grid-column: 3 / -1;
      margin-block-start: 6rem;
    }
  }

  @media (min-width: 64rem) {
    .opportunity {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.25rem;
    }

    .opportunity__intro {
      grid-column: 1 / 7;
    }

    .opportunity__transformations {
      grid-column: 8 / -1;
    }

    .opportunity__resolution {
      grid-column: 5 / -1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .opportunity__transformations li {
        animation: opportunity-focus linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 55%;
      }

      @keyframes opportunity-focus {
        from {
          opacity: 0.45;
          transform: translateY(1.5rem);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    }
  }
</style>
