---
import EditorialHeading from "@/components/ui/EditorialHeading.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import type { ContentStatus, OpportunityContent } from "@/schemas/skinko";
interface Props { status: ContentStatus; opportunity: OpportunityContent; copy?: { label: string } }
const { status, opportunity, copy } = Astro.props;
---
<section id="opportunity" class="opportunity" aria-labelledby="opportunity-title" data-status={status}>
  <header><SectionLabel index="03" label={copy?.label ?? "The opportunity"} /><StatusBadge {status} label="Propuesta" /></header>
  <EditorialHeading id="opportunity-title" level="h2" size="display-lg">{opportunity.statement}</EditorialHeading>
  {opportunity.description && <p class="description">{opportunity.description}</p>}
  <ol>{opportunity.shifts.map((shift) => <li><span>{shift.from}</span><b aria-hidden="true">→</b><strong>{shift.to}</strong></li>)}</ol>
  {opportunity.value && <p class="value">{opportunity.value}</p>}
  <p class="closing">{opportunity.closing}</p>
</section>
<style>
  .opportunity{padding-inline:var(--space-gutter);background:var(--color-fg-primary);color:var(--color-on-dark)}
  header{display:flex;justify-content:space-between;gap:1rem}.opportunity :global(.section-label){color:color-mix(in srgb,var(--color-on-dark) 65%,transparent)}
  .opportunity :global(.editorial-heading){max-width:15ch;margin-block:clamp(3rem,8vw,7rem)}.description,.value{max-width:42rem;margin:0 0 clamp(3rem,7vw,6rem);font-size:var(--text-body-lg);color:color-mix(in srgb,var(--color-on-dark) 78%,transparent)}.value{margin:clamp(3rem,7vw,6rem) 0 0 auto}
  ol{list-style:none;margin:0;padding:0;border-block-start:1px solid #ffffff40}li{display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;padding:1.25rem 0;border-block-end:1px solid #ffffff40;text-transform:uppercase;font:600 var(--text-caption)/1.3 var(--font-utility)}li strong{text-align:end}.closing{max-width:30ch;margin:clamp(4rem,10vw,8rem) 0 0 auto;font:400 clamp(1.6rem,4vw,3rem)/1.05 var(--font-editorial)}
</style>
