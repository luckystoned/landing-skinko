---
import EvidenceItem from "@/components/ui/EvidenceItem.astro";
import EditorialHeading from "@/components/ui/EditorialHeading.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import { gesCase } from "@/data/skinko/ges-case";
import { gesImages } from "@/data/skinko/assets";

const { status, data } = gesCase;
const evidenceAssets = [gesImages.landing, gesImages.flow, gesImages.communication];
---

<section
  id="ges-case-study"
  class="ges-case"
  aria-labelledby="ges-case-title"
  data-status={status}
>
  <header class="ges-case__header">
    <SectionLabel index="09" label="Documented Evidence" />
    <StatusBadge {status} label="Case in progress" />
  </header>

  <div class="ges-case__intro">
    <EditorialHeading id="ges-case-title" level="h2" size="display-lg">
      {data.headline}
    </EditorialHeading>
    <div>
      <p>{data.name}</p>
      <p>{data.summary}</p>
    </div>
  </div>

  <div class="ges-case__facts" aria-label="Datos verificados del caso en curso">
    {data.verifiedFacts.map((fact) => (
      <p>
        <strong>{fact.value}</strong>
        <span>{fact.label}</span>
      </p>
    ))}
  </div>

  <div class="ges-case__evidence">
    {data.evidence.map((evidence, index) => <EvidenceItem {...evidence} asset={evidenceAssets[index]} />)}
  </div>

  <div class="ges-case__workstreams">
    <p>Operating record · six connected workstreams</p>
    <ol>
      {data.workstreams.map((workstream) => (
        <li>
          <span>{workstream.index}</span>
          <h3>{workstream.label}</h3>
          <ul aria-label={`Alcance de ${workstream.label}`}>
            {workstream.details.map((detail) => <li>{detail}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>

  <footer class="ges-case__footer">
    <span>Current status</span>
    <p>{data.progressNote}</p>
  </footer>
</section>

<style>
  .ges-case {
    padding-inline: var(--space-gutter);
    background: color-mix(in srgb, var(--color-bg-primary) 82%, var(--color-border));
  }

  .ges-case__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: clamp(4rem, 10vw, 8rem);
  }

  .ges-case__header :global(.status-badge) {
    margin: 0;
    text-align: end;
  }

  .ges-case__intro {
    display: grid;
    gap: 3rem;
  }

  .ges-case__intro :global(.editorial-heading) {
    max-width: 10ch;
    text-transform: uppercase;
  }

  .ges-case__intro > div {
    display: grid;
    gap: 1.5rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--color-fg-primary);
  }

  .ges-case__intro p {
    margin: 0;
  }

  .ges-case__intro p:first-child {
    font-family: var(--font-utility);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ges-case__intro p:last-child {
    max-width: 32rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.5rem, 3vw, 2.75rem);
    line-height: 1.08;
  }

  .ges-case__facts {
    display: grid;
    margin-block: clamp(5rem, 12vw, 10rem);
    border-block-start: 1px solid var(--color-fg-primary);
  }

  .ges-case__facts p {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-items: end;
    margin: 0;
    padding-block: 1rem;
    border-block-end: 1px solid var(--color-border);
  }

  .ges-case__facts strong {
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 400;
    line-height: 0.85;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .ges-case__facts span {
    max-width: 18rem;
    padding-block-end: 0.2rem;
    font-family: var(--font-utility);
    font-size: var(--text-eyebrow);
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ges-case__evidence {
    display: grid;
    gap: clamp(4rem, 10vw, 8rem);
  }

  .ges-case__workstreams {
    margin-block-start: clamp(6rem, 14vw, 12rem);
  }

  .ges-case__workstreams > p,
  .ges-case__footer > span {
    margin: 0 0 1rem;
    font-family: var(--font-utility);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }

  .ges-case__workstreams > ol,
  .ges-case__workstreams ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ges-case__workstreams > ol {
    border-block-start: 1px solid var(--color-fg-primary);
  }

  .ges-case__workstreams > ol > li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.25rem;
    border-block-end: 1px solid var(--color-border);
  }

  .ges-case__workstreams > ol > li > span {
    font-family: var(--font-utility);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.09em;
  }

  .ges-case__workstreams h3 {
    margin: 0;
    font-size: clamp(2rem, 7vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .ges-case__workstreams ul {
    display: flex;
    grid-column: 2;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    color: var(--color-fg-muted);
    font-size: var(--text-caption);
  }

  .ges-case__workstreams ul li:not(:last-child)::after {
    margin-inline: 0.45em;
    content: "·";
  }

  .ges-case__footer {
    display: grid;
    gap: 1rem;
    margin-block-start: clamp(5rem, 10vw, 8rem);
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--color-fg-primary);
  }

  .ges-case__footer p {
    max-width: 28rem;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.05;
  }

  @media (min-width: 48rem) {
    .ges-case__intro {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: 1rem;
    }

    .ges-case__intro :global(.editorial-heading) {
      grid-column: 1 / 7;
    }

    .ges-case__intro > div {
      grid-column: 5 / -1;
    }

    .ges-case__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ges-case__facts p {
      grid-template-columns: minmax(7rem, auto) minmax(0, 1fr);
    }

    .ges-case__facts p:nth-child(odd) {
      border-inline-end: 1px solid var(--color-border);
      padding-inline-end: 1rem;
    }

    .ges-case__facts p:nth-child(even) {
      padding-inline-start: 1rem;
    }

    .ges-case__evidence {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: 1rem;
    }

    .ges-case__evidence > :global(*) {
      grid-column: 1 / 7;
    }

    .ges-case__evidence > :global(*:nth-child(2)) {
      grid-column: 3 / -1;
    }

    .ges-case__evidence > :global(*:nth-child(3)) {
      grid-column: 1 / 6;
    }

    .ges-case__workstreams > ol > li {
      grid-template-columns: 3rem minmax(13rem, 2fr) minmax(0, 3fr);
      align-items: start;
    }

    .ges-case__workstreams ul {
      grid-column: 3;
      padding-block-start: 0.4rem;
    }

    .ges-case__footer {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .ges-case__intro {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.25rem;
    }

    .ges-case__intro :global(.editorial-heading) {
      grid-column: 1 / 9;
    }

    .ges-case__intro > div {
      grid-column: 8 / -1;
    }

    .ges-case__facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .ges-case__facts p {
      display: grid;
      grid-template-columns: 1fr;
      align-content: space-between;
      min-height: 12rem;
      padding-inline: 1rem;
    }

    .ges-case__facts p:first-child {
      padding-inline-start: 0;
    }

    .ges-case__facts p:not(:last-child) {
      border-inline-end: 1px solid var(--color-border);
    }

    .ges-case__evidence {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.25rem;
    }

    .ges-case__evidence > :global(*:nth-child(1)) {
      grid-column: 1 / 8;
    }

    .ges-case__evidence > :global(*:nth-child(2)) {
      grid-column: 7 / -1;
    }

    .ges-case__evidence > :global(*:nth-child(3)) {
      grid-column: 2 / 7;
    }
  }
</style>
