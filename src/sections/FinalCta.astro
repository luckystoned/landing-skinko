---
import type { ClosingContent } from "@/schemas/skinko";
interface Props { closing: ClosingContent; copy?: { meta: string } }
const { closing, copy } = Astro.props;
---
<section id="closing" class="closing" aria-labelledby="closing-title">
  <div class="meta"><p>{closing.signature}</p><p>{copy?.meta ?? "Private proposal · 2027"}</p></div>
  <p class="territory">{closing.territory}</p><h2 id="closing-title">{closing.answer}</h2>
  <div class="prize"><p>{closing.prize}</p><p>{closing.descriptor}</p></div>
  <p class="invitation">{closing.invitation}</p>
</section>
<style>
  .closing{min-height:90svh;padding-inline:var(--space-gutter);background:var(--color-fg-primary);color:var(--color-on-dark);border:0}.meta{display:flex;justify-content:space-between;gap:1rem;padding-block-end:1rem;border-block-end:1px solid #ffffff60}.meta p,.territory,.prize p{margin:0;font:600 var(--text-eyebrow)/1.3 var(--font-utility);letter-spacing:.1em;text-transform:uppercase}.territory{margin:clamp(5rem,15vw,12rem) 0 1rem;color:#ffffffa8}.closing h2{max-width:13ch;margin:0;font-size:var(--text-display-lg)}.prize{display:flex;justify-content:space-between;gap:1rem;margin-block:clamp(4rem,10vw,8rem);padding-block:1rem;border-block:1px solid #ffffff60}.invitation{margin:0;text-align:end;font:italic 400 clamp(2rem,6vw,5rem)/1 var(--font-editorial)}
</style>
