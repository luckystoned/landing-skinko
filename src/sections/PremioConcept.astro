---
import EditorialHeading from "@/components/ui/EditorialHeading.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import type { ContentStatus, PrizeConcept } from "@/schemas/skinko";

interface Props {
  status: ContentStatus;
  concept: PrizeConcept;
}

const { status, concept } = Astro.props;
---

<section
  id="premio-concept"
  class="premio"
  aria-labelledby="premio-title"
  data-status={status}
>
  <header class="premio__header">
    <SectionLabel index="04" label="The Proposal" />
    <p class="premio__status">2027 — {status}</p>
  </header>

  <EditorialHeading id="premio-title" level="h2" size="display-xl">
    {concept.displayLines.map((line) => <span>{line}{" "}</span>)}
  </EditorialHeading>

  <div class="premio__brief">
    <p>{concept.summary}</p>
    <p>{concept.development}</p>
  </div>

  <ul class="premio__disciplines" aria-label="Disciplinas que cruza la propuesta">
    {concept.disciplines.map((discipline) => <li>{discipline}</li>)}
  </ul>

  <div class="premio__development">
    <p>La persona seleccionada trabajaría junto a</p>
    <ul aria-label="Equipo propuesto para el desarrollo">
      {concept.collaborators.map((collaborator) => <li>{collaborator}</li>)}
    </ul>
  </div>
</section>

<style>
  .premio {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 5rem) 0.75rem;
    padding-inline: var(--space-gutter);
    background: var(--color-bg-primary);
  }

  .premio__header {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .premio__status {
    margin: 0;
    font-family: var(--font-utility);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-align: end;
    text-transform: uppercase;
  }

  .premio :global(.editorial-heading) {
    grid-column: 1 / -1;
    font-size: clamp(4.5rem, 20vw, 9rem);
    line-height: 0.75;
    text-transform: uppercase;
  }

  .premio :global(.editorial-heading) span {
    display: block;
  }

  .premio :global(.editorial-heading) span:nth-child(2) {
    padding-inline-start: 0.45em;
  }

  .premio :global(.editorial-heading) span:nth-child(3) {
    font-size: 0.63em;
    line-height: 0.95;
    text-align: end;
  }

  .premio :global(.editorial-heading) span:last-child {
    font-size: 0.85em;
    color: var(--color-metal);
    text-align: end;
  }

  .premio__brief {
    display: grid;
    grid-column: 1 / -1;
    gap: 1.5rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--color-fg-primary);
  }

  .premio__brief p {
    margin: 0;
    max-width: 31rem;
  }

  .premio__brief p:first-child {
    font-family: var(--font-editorial);
    font-size: clamp(1.75rem, 4vw, 3.25rem);
    line-height: 1.02;
  }

  .premio__disciplines,
  .premio__development ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .premio__disciplines {
    display: flex;
    grid-column: 1 / -1;
    flex-wrap: wrap;
    gap: 0.5rem 0;
    padding-block: 1rem;
    border-block: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 4.75rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .premio__disciplines li:not(:last-child)::after {
    margin-inline: 0.28em;
    content: "×";
    color: var(--color-metal);
  }

  .premio__development {
    grid-column: 1 / -1;
  }

  .premio__development > p {
    margin: 0 0 1.5rem;
    font-family: var(--font-utility);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }

  .premio__development ul {
    display: grid;
    border-block-start: 1px solid var(--color-fg-primary);
  }

  .premio__development li {
    padding-block: 0.8rem;
    border-block-end: 1px solid var(--color-border);
    font-family: var(--font-utility);
    font-size: clamp(1rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .premio {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: 1rem;
    }

    .premio :global(.editorial-heading) {
      grid-column: 1 / 8;
      font-size: clamp(7rem, 14vw, 12.5rem);
    }

    .premio__brief {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .premio__brief p:last-child {
      align-self: end;
      max-width: 25rem;
    }

    .premio__development {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .premio__development > p {
      max-width: 16rem;
    }
  }

  @media (min-width: 64rem) {
    .premio {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.25rem;
    }

    .premio :global(.editorial-heading) {
      grid-column: 1 / 11;
    }

    .premio__brief {
      grid-column: 5 / -1;
    }

    .premio__development {
      grid-column: 5 / -1;
    }
  }
</style>
