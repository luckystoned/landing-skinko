---
import EditorialHeading from "@/components/ui/EditorialHeading.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import type { ContentStatus, PrizeConcept } from "@/schemas/skinko";
interface Props { status: ContentStatus; concept: PrizeConcept; copy?: { label: string; status: string } }
const { status, concept, copy } = Astro.props;
---
<section id="premio" class="premio" aria-labelledby="premio-title" data-status={status}>
  <header><SectionLabel index="04" label={copy?.label ?? "The site-specific proposal"} /><StatusBadge {status} label={copy?.status ?? "Propuesta 2027"} /></header>
  <EditorialHeading id="premio-title" level="h2" size="display-xl">{concept.displayLines.map((line) => <span>{line}</span>)}</EditorialHeading>
  <p class="lead">{concept.summary}</p>
  <div class="definition"><p>{concept.definition}</p><ul>{concept.principles.map((item) => <li>{item}</li>)}</ul></div>
  <p class="formula" aria-label={concept.formula.join(" más ")}>{concept.formula.map((item, i) => <><strong>{item}</strong>{i < concept.formula.length - 1 && <span aria-hidden="true">＋</span>}</>)}</p>
  <p class="process">{concept.processSummary}</p>
</section>
<style>
  .premio{padding-inline:var(--space-gutter)}header{display:flex;justify-content:space-between;gap:1rem}.premio :global(.editorial-heading){margin:clamp(3rem,8vw,7rem) 0}.premio :global(.editorial-heading) span{display:block}.premio :global(.editorial-heading) span:nth-child(even){padding-inline-start:clamp(1rem,10vw,8rem)}
  .lead{max-width:32ch;margin:0 0 clamp(5rem,12vw,10rem) auto;font:400 clamp(1.5rem,3vw,2.6rem)/1.12 var(--font-editorial)}.definition{display:grid;gap:2rem;padding-block:2rem;border-block:1px solid var(--color-border)}.definition p{max-width:34ch;margin:0;font-size:var(--text-body-lg)}ul{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin:0;padding:0;list-style:none;text-transform:uppercase;font:600 var(--text-eyebrow)/1.3 var(--font-utility)}
  .formula{display:flex;flex-wrap:wrap;justify-content:center;gap:1rem 2rem;margin:clamp(5rem,12vw,10rem) 0;font:400 clamp(2.4rem,8vw,7rem)/.9 var(--font-display)}.formula strong{font-weight:400}.formula span{color:var(--color-metal)}.process{max-width:42rem;margin:0 auto;font-size:var(--text-body-lg)}
  @media(min-width:48rem){.definition{grid-template-columns:1fr 1fr;align-items:end}}
</style>
