---
import type { ResponsiveImage } from "@/schemas/skinko";
type FigureRatio = "4:5" | "3:2" | "16:9";

interface Props {
  index: string;
  title: string;
  ratio: FigureRatio;
  caption?: string;
  asset?: ResponsiveImage;
  priority?: boolean;
}

const { index, title, ratio, caption, asset, priority = false } = Astro.props;
const ratios: Record<FigureRatio, string> = {
  "4:5": "4 / 5",
  "3:2": "3 / 2",
  "16:9": "16 / 9",
};
---

<figure class="asset-figure" style={`--figure-ratio: ${ratios[ratio]}; --image-position: ${asset?.objectPosition ?? "50% 50%"}; --image-position-desktop: ${asset?.objectPositionDesktop ?? asset?.objectPosition ?? "50% 50%"}`}>
  <div class="asset-figure__frame">
    {
      asset ? (
        <img
          src={asset.src}
          srcset={asset.srcset}
          sizes={asset.sizes}
          alt={asset.alt}
          width={asset.width}
          height={asset.height}
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : undefined}
          decoding="async"
        />
      ) : (
        <div class="asset-figure__pending" aria-hidden="true">
          <span>FIG. {index}</span>
          <strong>{title}</strong>
          <span>{ratio}</span>
          <span>Asset required</span>
        </div>
      )
    }
  </div>
  <figcaption>
    <span>{index}</span>
    <span>
      <strong>{title}</strong>
      {caption && <span>{caption}</span>}
    </span>
  </figcaption>
</figure>

<style>
  .asset-figure {
    min-width: 0;
    margin: 0;
  }

  .asset-figure__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--figure-ratio);
    background:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px),
      var(--color-bg-primary);
    background-size: 2.5rem 2.5rem;
    border: 1px solid var(--color-border);
  }

  .asset-figure__frame::after {
    position: absolute;
    inset: 0;
    content: "";
    background: linear-gradient(135deg, transparent 49.85%, var(--color-border) 50%, transparent 50.15%);
    pointer-events: none;
  }

  img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--image-position);
  }

  @media (min-width: 48rem) {
    img { object-position: var(--image-position-desktop); }
  }

  .asset-figure__pending {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    padding: clamp(1rem, 3vw, 2rem);
    font-family: var(--font-utility);
    font-size: var(--text-eyebrow);
    line-height: 1.2;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .asset-figure__pending strong {
    align-self: center;
    grid-column: 1 / -1;
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .asset-figure__pending span:nth-last-child(2) {
    align-self: end;
  }

  .asset-figure__pending span:last-child {
    align-self: end;
    text-align: end;
  }

  figcaption {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block-start: 0.875rem;
    font-family: var(--font-utility);
    font-size: var(--text-caption);
    line-height: 1.35;
  }

  figcaption > span:last-child {
    display: grid;
    gap: 0.25rem;
  }

  figcaption strong {
    font-size: var(--text-eyebrow);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  figcaption span span {
    color: var(--color-fg-muted);
  }
</style>
