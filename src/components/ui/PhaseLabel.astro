---
interface Props {
  phase: number;
  label: string;
  description: string;
}

const { phase, label, description } = Astro.props;
const index = String(phase).padStart(2, "0");
---

<div class="phase-label">
  <span class="phase-label__index">{index}</span>
  <h3>{label}</h3>
  <p>{description}</p>
</div>

<style>
  .phase-label {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    min-height: 15rem;
    padding-block: 1rem 1.5rem;
    border-block-start: 1px solid var(--color-border);
  }

  .phase-label__index {
    font-family: var(--font-utility);
    font-size: var(--text-eyebrow);
    line-height: 1.2;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
  }

  h3 {
    min-width: 0;
    margin: 0;
    align-self: start;
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  p {
    grid-column: 2;
    align-self: end;
    max-width: 26rem;
    margin: 2rem 0 0;
    color: var(--color-fg-muted);
    font-size: var(--text-caption);
    line-height: 1.45;
  }

  @media (min-width: 64rem) {
    .phase-label {
      min-height: min(23rem, 40svh);
    }

    h3 {
      font-size: clamp(3rem, 3.5vw, 4.5rem);
    }
  }
</style>
