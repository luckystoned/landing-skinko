---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { chapterProposal } from "@/data/skinko/chapterProposal";
import { nuevaProposal, nuevaUi } from "@/data/skinko/nueva";
import { nuevaMetadata } from "@/seo/metadata";
import { buildWebPageSchema } from "@/seo/schemas";
import ChapterHero from "@/sections/ChapterHero.astro";
import BrandOpportunity from "@/sections/BrandOpportunity.astro";
import FirstExperience from "@/sections/FirstExperience.astro";
import CreativeJourney from "@/sections/CreativeJourney.astro";
import CulturalReferences from "@/sections/CulturalReferences.astro";
import ChapterSupport from "@/sections/ChapterSupport.astro";
import ChapterNextSteps from "@/sections/ChapterNextSteps.astro";
import HiddenSystem from "@/sections/HiddenSystem.astro";
import "@/styles/chapter.css";

const schema = buildWebPageSchema({
  name: nuevaMetadata.title,
  description: nuevaMetadata.description,
  url: new URL(nuevaMetadata.canonicalPath, Astro.site ?? Astro.url.origin).href,
});
---

<BaseLayout metadata={nuevaMetadata} {schema}>
  <main id="content" class="chapter-page">
    <ChapterHero content={chapterProposal.hero} navigation={chapterProposal.navigation} />
    <BrandOpportunity content={chapterProposal.opportunity} />
    <FirstExperience content={chapterProposal.experience} />
    <CreativeJourney content={chapterProposal.journey} />
    <CulturalReferences content={chapterProposal.references} />
    <ChapterSupport content={chapterProposal.support} />
    <HiddenSystem system={nuevaProposal.hiddenSystem.data} copy={nuevaUi.hiddenSystem} index="06" tone="violet" />
    <ChapterNextSteps content={chapterProposal.nextSteps} />
  </main>
</BaseLayout>
