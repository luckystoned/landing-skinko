---
import { proposal } from "@/data/skinko/proposal";
import { benchmarks } from "@/data/skinko/benchmarks";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { homeMetadata } from "@/seo/metadata";
import { buildWebPageSchema } from "@/seo/schemas";
import ArtOfSkin from "@/sections/ArtOfSkin.astro";
import BandadasValue from "@/sections/BandadasValue.astro";
import Benchmarks from "@/sections/Benchmarks.astro";
import FinalCta from "@/sections/FinalCta.astro";
import GesCaseStudy from "@/sections/GesCaseStudy.astro";
import Hero from "@/sections/Hero.astro";
import HiddenSystem from "@/sections/HiddenSystem.astro";
import Journey from "@/sections/Journey.astro";
import Opportunity from "@/sections/Opportunity.astro";
import PremioConcept from "@/sections/PremioConcept.astro";
import Roadmap from "@/sections/Roadmap.astro";
import WhySiteSpecific from "@/sections/WhySiteSpecific.astro";

const canonical = new URL(homeMetadata.canonicalPath, Astro.site ?? Astro.url.origin);
const schema = buildWebPageSchema({
  name: homeMetadata.title,
  description: homeMetadata.description,
  url: canonical.href,
});
---

<BaseLayout metadata={homeMetadata} schema={schema}>
  <main id="content" class="mx-auto max-w-content">
    <Hero
      territory={proposal.brandTerritory.data}
      prize={proposal.prize.data}
    />
    <ArtOfSkin experiences={proposal.artExperiences.data} />
    <Opportunity
      status={proposal.opportunity.status}
      opportunity={proposal.opportunity.data}
    />
    <PremioConcept
      status={proposal.prize.status}
      concept={proposal.prize.data}
    />
    <WhySiteSpecific content={proposal.siteSpecific.data} />
    <Journey
      status={proposal.journey.status}
      phases={proposal.journey.data}
    />
    <Benchmarks {benchmarks} />
    <HiddenSystem system={proposal.hiddenSystem.data} />
    <GesCaseStudy />
    <BandadasValue value={proposal.bandadasValue.data} />
    <Roadmap status={proposal.roadmap.status} milestones={proposal.roadmap.data} />
    <FinalCta closing={proposal.closing.data} />
  </main>
</BaseLayout>
